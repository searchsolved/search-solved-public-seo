#!/bin/bash
#
# Pre-commit hook to ensure Python files have license headers
#
# Install: git config core.hooksPath .githooks
#

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Required text that must appear in Python files
LICENSE_MARKER="Author: Lee Foot"
WEBSITE_MARKER="leefoot.com"

# Get list of staged Python files
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')

if [ -z "$STAGED_PY_FILES" ]; then
    exit 0
fi

MISSING_LICENSE=()

for file in $STAGED_PY_FILES; do
    # Skip __init__.py files
    if [[ "$file" == *"__init__.py" ]]; then
        continue
    fi

    # Check if file contains the license marker
    if ! grep -q "$LICENSE_MARKER" "$file" 2>/dev/null; then
        MISSING_LICENSE+=("$file")
    fi
done

if [ ${#MISSING_LICENSE[@]} -gt 0 ]; then
    echo -e "${RED}ERROR: The following Python files are missing the license header:${NC}"
    echo ""
    for file in "${MISSING_LICENSE[@]}"; do
        echo -e "  ${YELLOW}$file${NC}"
    done
    echo ""
    echo -e "${RED}Each Python file must include:${NC}"
    echo ""
    echo '  # Author   : Lee Foot'
    echo '  # Website  : https://leefoot.com'
    echo ""
    echo "Or in the docstring:"
    echo ""
    echo '  """'
    echo '  Tool Name'
    echo '  Author: Lee Foot'
    echo '  Website: https://leefoot.com'
    echo '  """'
    echo ""
    echo -e "Add the header and stage the files again, or bypass with: ${YELLOW}git commit --no-verify${NC}"
    exit 1
fi

echo -e "${GREEN}License check passed for ${#STAGED_PY_FILES[@]} Python file(s)${NC}"
exit 0
